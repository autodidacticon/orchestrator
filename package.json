{
  "name": "@autodidacticon/orchestrator",
  "version": "0.4.0",
  "description": "Parallel coding-agent orchestrator over a task DAG",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "orchestrator": "dist/src/main.js",
    "orchestrator-ctl": "dist/src/operator/cli.js",
    "orchestrator-mcp": "dist/src/operator/mcp.js",
    "orchestrator-mcp-shim": "dist/src/agent/mcp-shim.js",
    "orchestrator-work": "hosts/codex/bin/work.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./daemon": {
      "types": "./src/main.ts",
      "default": "./dist/src/main.js"
    },
    "./operator-mcp": {
      "types": "./src/operator/mcp.ts",
      "default": "./dist/src/operator/mcp.js"
    },
    "./agent-shim": {
      "types": "./src/agent/mcp-shim.ts",
      "default": "./dist/src/agent/mcp-shim.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "hosts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
