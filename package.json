{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Parallel coding-agent orchestrator over a task DAG",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": {
    "orchestrator": "./dist/src/main.js",
    "orchestrator-ctl": "./dist/src/operator/cli.js",
    "orchestrator-mcp-shim": "./dist/src/agent/mcp-shim.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
